# Configuración del backend (copiar a .env). NO subir .env a git.
NODE_ENV=development
PORT=3100

# Base de datos PostgreSQL (coincide con docker-compose.yml)
DB_HOST=localhost
DB_PORT=5433
DB_USER=invitaciones
DB_PASSWORD=invitaciones_dev
DB_NAME=invitaciones

# --- Producción (Railway) ---
# Railway entrega la conexión completa en una sola variable. Si DATABASE_URL
# está definida, tiene prioridad sobre las variables DB_* de arriba.
# DATABASE_URL=postgresql://usuario:password@host:puerto/basededatos
# Activar SSL en proveedores gestionados (Railway, etc.)
# DB_SSL=true
# Crear/actualizar el esquema automáticamente desde las entidades.
# Útil para el MVP cuando aún no hay migraciones. En producción real usar migraciones.
# DB_SYNCHRONIZE=true

# Origen permitido para CORS. Acepta varios separados por coma
# (ej. desarrollo local + dominio de Vercel en producción).
CORS_ORIGIN=http://localhost:4300

# URL pública del frontend (para enlaces de retorno de pago y del enlace publicado)
FRONTEND_URL=http://localhost:4300

# URL pública del backend (para la imagen Open Graph en el HTML de compartir)
PUBLIC_API_URL=http://localhost:3100

# Stripe (modo prueba). Si STRIPE_SECRET_KEY está vacío, se usa el modo de pago SIMULADO.
# La clave secreta vive SOLO en el backend. Nunca en el frontend.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Precio de publicación de una invitación, en centavos de MXN (hipótesis a validar).
PUBLISH_PRICE_CENTS=19900

# Vigencia del enlace publicado, en días (política Etapa 3).
PUBLISH_VALIDITY_DAYS=180

# Secreto para firmar los JWT de autenticación. Cambiar por un valor largo y aleatorio.
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRES_IN=7d
